---
import Layout from "../layouts/Layout.astro";
import { CODE_SOURCE, type CodeLang } from "../lib/code-samples.ts";
import { GRAPH_EDGES, GRAPH_NODES, GRAPH_VIEWBOX, START_ID } from "../lib/example-graph.ts";
import { highlightCode } from "../lib/highlight.ts";

// Node radius in viewBox units — edges are trimmed to stop at the circle's
// edge (not its center) so the arrowhead lands right at the boundary.
const NODE_RADIUS = 28;
const nodeById = new Map(GRAPH_NODES.map((node) => [node.id, node]));

const edgeRenders = GRAPH_EDGES.map((edge) => {
  const from = nodeById.get(edge.from)!;
  const to = nodeById.get(edge.to)!;
  const dx = to.x - from.x;
  const dy = to.y - from.y;
  const dist = Math.hypot(dx, dy);
  const ux = dx / dist;
  const uy = dy / dist;
  const x1 = from.x + ux * NODE_RADIUS;
  const y1 = from.y + uy * NODE_RADIUS;
  const x2 = to.x - ux * NODE_RADIUS;
  const y2 = to.y - uy * NODE_RADIUS;
  const midX = (x1 + x2) / 2;
  const midY = (y1 + y2) / 2;
  const labelOffset = 16;
  return { edge, x1, y1, x2, y2, labelX: midX + -uy * labelOffset, labelY: midY + ux * labelOffset };
});

const LANGS: { id: CodeLang; label: string }[] = [
  { id: "python", label: "Python" },
  { id: "java", label: "Java" },
];
const codeHtml: Record<CodeLang, string> = {
  python: await highlightCode(CODE_SOURCE.python, "python"),
  java: await highlightCode(CODE_SOURCE.java, "java"),
};
---

<Layout title="Dijkstra, Traced">
  <header>
    <nav aria-label="Primary">
      <a href="./">Home</a>
    </nav>
  </header>
  <main>
    <h1>Dijkstra, Traced</h1>
    <p class="lede">
      One fixed graph, one algorithm. Press Run and watch the pop-and-relax
      loop drive the animation, the narration, and the exact line of real
      Python or Java that caused it — or step through it yourself with Prev
      and Next.
    </p>

    <ul class="legend" aria-hidden="true">
      <li><span class="swatch swatch-frontier"></span> Frontier</li>
      <li><span class="swatch swatch-visited"></span> Visited</li>
      <li><span class="swatch swatch-path"></span> Shortest path</li>
    </ul>

    <div class="visualization">
      <figure class="graph-figure">
        <div class="graph-stage">
          <svg
            class="graph"
            data-testid="graph"
            viewBox={`0 0 ${GRAPH_VIEWBOX.width} ${GRAPH_VIEWBOX.height}`}
            role="img"
            aria-label={`Directed graph with ${GRAPH_NODES.length} nodes and ${GRAPH_EDGES.length} weighted edges, from S (start) to T (end)`}
          >
            <defs>
              <marker
                id="arrow-idle"
                viewBox="0 0 10 10"
                refX="9"
                refY="5"
                markerWidth="6"
                markerHeight="6"
                orient="auto-start-reverse"
              >
                <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--panel-line)" />
              </marker>
              <marker
                id="arrow-path"
                viewBox="0 0 10 10"
                refX="9"
                refY="5"
                markerWidth="6"
                markerHeight="6"
                orient="auto-start-reverse"
              >
                <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--redline)" />
              </marker>
            </defs>

            {
              edgeRenders.map(({ edge, x1, y1, x2, y2, labelX, labelY }) => (
                <g class="graph-edge" data-testid="graph-edge" data-edge-id={edge.id} data-state="idle">
                  <line x1={x1} y1={y1} x2={x2} y2={y2} marker-end="url(#arrow-idle)" />
                  <text x={labelX} y={labelY} class="edge-weight">
                    {edge.weight}
                  </text>
                </g>
              ))
            }

            {
              GRAPH_NODES.map((node) => (
                <g
                  class="graph-node"
                  data-testid="graph-node"
                  data-node-id={node.id}
                  data-state="idle"
                  transform={`translate(${node.x} ${node.y})`}
                >
                  <circle r={NODE_RADIUS} />
                  <text class="node-label" dominant-baseline="middle" text-anchor="middle">
                    {node.label}
                  </text>
                  <text class="node-cost" data-testid="node-cost" text-anchor="middle" y={NODE_RADIUS + 18}>
                    {node.id === START_ID ? "g=0" : "g=∞"}
                  </text>
                </g>
              ))
            }
          </svg>
          <figcaption class="graph-caption">S = start &middot; T = end</figcaption>
        </div>

        <section class="controls" data-testid="controls" aria-label="Walkthrough controls">
          <div class="action-row">
            <button type="button" class="btn btn-fill" data-testid="run-button">▶ Run</button>
            <button type="button" class="btn btn-outline" data-testid="step-prev" disabled>⟨ Prev</button>
            <button type="button" class="btn btn-outline" data-testid="step-next">Next ⟩</button>
          </div>
          <p class="step-counter" data-testid="step-counter"></p>
          <p class="step-caption" data-testid="step-caption"></p>
        </section>
      </figure>

      <aside class="code-panel" data-testid="code-panel" aria-label="Dijkstra source code">
        <h2>Source</h2>
        <div class="code-tabs" role="group" aria-label="Code language">
          {
            LANGS.map(({ id, label }, i) => (
              <button
                type="button"
                class="btn btn-outline"
                data-testid={`code-tab-${id}`}
                data-lang={id}
                aria-pressed={i === 0 ? "true" : "false"}
              >
                {label}
              </button>
            ))
          }
        </div>
        {
          LANGS.map(({ id }, i) => (
            <div class="code-block" data-testid="code-block" data-lang={id} hidden={i !== 0} set:html={codeHtml[id]} />
          ))
        }
      </aside>
    </div>

    <p class="sr-only" role="status" aria-live="polite" data-testid="graph-status"></p>

    <div class="result-banner" data-testid="result-banner" hidden>
      <p class="banner-headline" data-role="headline"></p>
      <p class="banner-detail" data-role="detail"></p>
    </div>
  </main>
  <script src="../scripts/main.ts"></script>
</Layout>
