---
import Layout from "../layouts/Layout.astro";
import { ROUNDS } from "../lib/probe-rounds.ts";

const first = ROUNDS[0];
---

<Layout title="Tool or Not?">
  <header>
    <nav aria-label="Primary">
      <a href="./">Home</a>
    </nav>
  </header>
  <main>
    <h1>Tool or Not?</h1>
    <p class="lede">
      An LLM only ever generates its next token — but a model can also
      quietly know things its own words don't say. Read what the model says
      about itself below, guess whether it actually needs a tool, then watch
      its hidden state answer for real.
    </p>

    <section data-testid="game">
      <div class="game-meta">
        <p data-testid="round-counter">Round 1 of {ROUNDS.length}</p>
        <p data-testid="score">Score: 0/0 · Streak: 0</p>
      </div>

      <div class="prompt-card" data-testid="prompt-card">
        <p class="card-label">The prompt:</p>
        <p class="card-text" data-role="text">&ldquo;{first.prompt}&rdquo;</p>
      </div>

      <div class="reasoning-card" data-testid="stated-reasoning">
        <p class="card-label">The model says:</p>
        <p class="card-text" data-role="text">&ldquo;{first.statedReasoning}&rdquo;</p>
      </div>

      <div class="guess-row" role="group" aria-label="Your guess">
        <p id="guess-prompt">Does this prompt actually need a tool call?</p>
        <button type="button" class="btn btn-outline" data-testid="guess-yes" aria-describedby="guess-prompt">
          🔧 Needs a tool
        </button>
        <button type="button" class="btn btn-outline" data-testid="guess-no" aria-describedby="guess-prompt">
          🚫 No tool needed
        </button>
      </div>

      <div class="model-stack">
        <ol class="layer-stack" data-testid="layer-stack">
          <li data-testid="layer-1" data-state="idle"><span>Layer 1</span></li>
          <li data-testid="layer-2" data-state="idle"><span>Layer 2</span></li>
          <li data-testid="layer-3" data-state="idle"><span>Layer 3</span></li>
          <li data-testid="layer-4" data-state="idle">
            <span>Layer 4</span>
            <span class="hidden-vector" data-testid="hidden-vector" aria-hidden="true"></span>
          </li>
        </ol>
        <div class="probe-arrow" data-testid="probe-arrow" data-state="idle" aria-hidden="true">
          &rarr;
        </div>
        <div class="probe-box" data-testid="probe-box" data-state="idle">
          <p class="card-label">Probe</p>
          <p class="card-text" data-role="verdict">Waiting&hellip;</p>
        </div>
      </div>

      <div class="reveal" data-testid="reveal" hidden>
        <p data-role="verdict-line"></p>
        <p data-role="match-line"></p>
        <p data-role="model-line"></p>
        <button type="button" class="btn btn-fill" data-testid="next-round">Next round &rarr;</button>
      </div>

      <p class="sr-only" role="status" aria-live="polite" data-testid="game-status"></p>
    </section>

    <section data-testid="summary" hidden>
      <h2>Session complete</h2>
      <p data-role="summary-text"></p>
      <button type="button" class="btn btn-fill" data-testid="play-again">Play again</button>
    </section>
  </main>
  <script src="../scripts/main.ts"></script>
</Layout>
