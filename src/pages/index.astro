---
import Layout from "../layouts/Layout.astro";
import { createOpenGraph, createTrapGraph, type ExampleGraph } from "../lib/graphs.ts";
import { PSEUDOCODE_LINES } from "../lib/pseudocode.ts";

const VIEW_WIDTH = 800;
const VIEW_HEIGHT = 500;
const MARGIN = 70;
const NODE_RADIUS = 28;

// The only pixel-space math in the whole graph feature: scale + center each
// example graph's abstract x/y (used for the Euclidean heuristic in
// graph-search.ts) into the SVG viewBox. graphs.ts itself stays pure data,
// same as mazes.ts having zero grid-placement math today.
function layoutPositions(nodes: ExampleGraph["nodes"]): Map<string, { cx: number; cy: number }> {
  const xs = nodes.map((node) => node.x);
  const ys = nodes.map((node) => node.y);
  const minX = Math.min(...xs);
  const maxX = Math.max(...xs);
  const minY = Math.min(...ys);
  const maxY = Math.max(...ys);
  const spanX = maxX - minX || 1;
  const spanY = maxY - minY || 1;
  const scale = Math.min((VIEW_WIDTH - 2 * MARGIN) / spanX, (VIEW_HEIGHT - 2 * MARGIN) / spanY);
  const offsetX = (VIEW_WIDTH - spanX * scale) / 2;
  const offsetY = (VIEW_HEIGHT - spanY * scale) / 2;
  return new Map(
    nodes.map((node) => [
      node.id,
      { cx: offsetX + (node.x - minX) * scale, cy: offsetY + (node.y - minY) * scale },
    ]),
  );
}

type NodeView = { id: string; label: string; cx: number; cy: number; state: "start" | "end" | "empty" };
type EdgeView = {
  id: string;
  a: string;
  b: string;
  weight: number;
  x1: number;
  y1: number;
  x2: number;
  y2: number;
  labelX: number;
  labelY: number;
};
type GraphView = { id: string; description: string; nodes: NodeView[]; edges: EdgeView[] };

function buildView(id: string, description: string, graph: ExampleGraph): GraphView {
  const positions = layoutPositions(graph.nodes);
  const nodes: NodeView[] = graph.nodes.map((node) => {
    const pos = positions.get(node.id)!;
    const state = node.id === graph.start ? "start" : node.id === graph.end ? "end" : "empty";
    return { id: node.id, label: node.label, cx: pos.cx, cy: pos.cy, state };
  });
  const edges: EdgeView[] = graph.edges.map((edge) => {
    const a = positions.get(edge.a)!;
    const b = positions.get(edge.b)!;
    return {
      id: edge.id,
      a: edge.a,
      b: edge.b,
      weight: edge.weight,
      x1: a.cx,
      y1: a.cy,
      x2: b.cx,
      y2: b.cy,
      labelX: (a.cx + b.cx) / 2,
      labelY: (a.cy + b.cy) / 2 - 10,
    };
  });
  return { id, description, nodes, edges };
}

const graphViews: GraphView[] = [
  buildView("open", "the open example — every weight finds the same shortest route", createOpenGraph()),
  buildView("trap", "the trap example — a decoy node that fools a high weight", createTrapGraph()),
];
---

<Layout title="One Dial, Three Pathfinders">
  <header>
    <nav aria-label="Primary">
      <a href="./">Home</a>
    </nav>
  </header>
  <main>
    <h1>One Dial, Three Pathfinders</h1>
    <p class="lede">
      Dijkstra's algorithm, A*, and greedy best-first search are the same
      weighted search at three settings of one dial. Drag the weight slider
      below and re-run — watch the "shortest path" guarantee hold, hold, then
      quietly stop holding.
    </p>

    <section class="controls" aria-label="Graph controls">
      <div class="mode-group" role="group" aria-label="Edge and node mode">
        <button type="button" class="btn btn-outline" data-testid="mode-block" aria-pressed="true">
          🚫 Block edge
        </button>
        <button type="button" class="btn btn-outline" data-testid="mode-open" aria-pressed="false">
          🔓 Open edge
        </button>
        <button type="button" class="btn btn-outline" data-testid="mode-start" aria-pressed="false">
          🟢 Set start
        </button>
        <button type="button" class="btn btn-outline" data-testid="mode-end" aria-pressed="false">
          🔴 Set end
        </button>
      </div>

      <div class="weight-control">
        <label for="weight-slider">Heuristic weight</label>
        <p class="weight-label" data-testid="weight-label">A* (weight 1.0)</p>
        <input type="range" id="weight-slider" data-testid="weight-slider" min="0" max="3" step="0.1" value="1" />
        <div class="weight-scale" aria-hidden="true">
          <span>0 = Dijkstra</span>
          <span>1 = A*</span>
          <span>&gt;1 = Greedy</span>
        </div>
      </div>

      <div class="action-row">
        <button type="button" class="btn btn-fill" data-testid="run-button">▶ Run</button>
        <button type="button" class="btn btn-outline" data-testid="clear-blocks-button">Clear blocks</button>
        <button type="button" class="btn btn-outline" data-testid="load-trap-button">Load trap graph</button>
      </div>
    </section>

    <div class="visualization">
      <div class="graph-stage" data-testid="graph-stage">
        {
          graphViews.map((view) => (
            <svg
              class="graph"
              data-testid="graph"
              data-graph-id={view.id}
              viewBox={`0 0 ${VIEW_WIDTH} ${VIEW_HEIGHT}`}
              role="group"
              aria-label={`Pathfinding graph: ${view.description}`}
              {...(view.id !== "open" ? { hidden: true } : {})}
            >
              {view.edges.map((edge) => (
                <g class="graph-edge-group">
                  <line
                    class="graph-edge-hit"
                    data-testid="graph-edge-hit"
                    data-edge-id={edge.id}
                    x1={edge.x1}
                    y1={edge.y1}
                    x2={edge.x2}
                    y2={edge.y2}
                    tabindex="0"
                    role="button"
                    aria-label={`Edge ${edge.a} to ${edge.b}, weight ${edge.weight}, open`}
                  />
                  <line
                    class="graph-edge"
                    data-testid="graph-edge"
                    data-edge-id={edge.id}
                    data-state="open"
                    x1={edge.x1}
                    y1={edge.y1}
                    x2={edge.x2}
                    y2={edge.y2}
                    aria-hidden="true"
                  />
                  <text
                    class="graph-edge-weight"
                    data-testid="graph-edge-weight"
                    data-edge-id={edge.id}
                    x={edge.labelX}
                    y={edge.labelY}
                    aria-hidden="true"
                  >
                    {edge.weight}
                  </text>
                </g>
              ))}
              {view.nodes.map((node) => (
                <g
                  class="graph-node"
                  data-testid="graph-node"
                  data-node-id={node.id}
                  data-state={node.state}
                  tabindex="0"
                  role="button"
                  aria-label={`Node ${node.label}, ${node.state}`}
                >
                  <circle cx={node.cx} cy={node.cy} r={NODE_RADIUS} />
                  <text class="graph-node-label" x={node.cx} y={node.cy} aria-hidden="true">
                    {node.label}
                  </text>
                  <text
                    class="graph-node-cost"
                    data-testid="graph-node-cost"
                    data-node-id={node.id}
                    x={node.cx}
                    y={node.cy + NODE_RADIUS + 16}
                    aria-hidden="true"
                  />
                </g>
              ))}
            </svg>
          ))
        }
      </div>

      <aside class="pseudocode-panel" data-testid="pseudocode-panel" aria-label="Algorithm pseudocode">
        <h2>Pseudocode</h2>
        <ol>
          {
            PSEUDOCODE_LINES.map((line) => (
              <li data-testid="pseudo-line" data-line={line.line} data-state="idle">
                {line.text}
              </li>
            ))
          }
        </ol>
      </aside>
    </div>

    <div class="step-controls" data-testid="step-controls" hidden>
      <button type="button" class="btn btn-outline" data-testid="step-prev" disabled>⟨ Prev</button>
      <p class="step-counter" data-testid="step-counter"></p>
      <button type="button" class="btn btn-outline" data-testid="step-next">Next ⟩</button>
      <p class="step-caption" data-testid="step-caption"></p>
    </div>

    <p class="sr-only" role="status" aria-live="polite" data-testid="graph-status"></p>

    <div class="result-banner" data-testid="result-banner" hidden>
      <p class="banner-headline" data-role="headline"></p>
      <p class="banner-detail" data-role="detail"></p>
    </div>

    <table class="history-table" data-testid="history-table">
      <caption>Run history</caption>
      <thead>
        <tr>
          <th scope="col">Weight</th>
          <th scope="col">Algorithm</th>
          <th scope="col">Path cost</th>
          <th scope="col">Optimal?</th>
          <th scope="col">Nodes expanded</th>
        </tr>
      </thead>
      <tbody data-testid="history-body"></tbody>
    </table>
  </main>
  <script src="../scripts/main.ts"></script>
</Layout>
